# name: test/sql/hashfuncs_parameter_names.test
# description: duckdb_functions() reports the declared parameter names instead of col<N>
# group: [hashfuncs]

require hashfuncs

query II
SELECT DISTINCT function_name, parameters FROM duckdb_functions()
WHERE function_name IN ('murmurhash3_128', 'murmurhash3_32', 'murmurhash3_x64_128', 'rapidhash', 'rapidhash_micro', 'rapidhash_nano', 'xxh32', 'xxh3_128', 'xxh3_128_hex', 'xxh3_64', 'xxh64')
ORDER BY ALL;
----
murmurhash3_128	[value]
murmurhash3_128	[value, seed]
murmurhash3_32	[value]
murmurhash3_32	[value, seed]
murmurhash3_x64_128	[value]
murmurhash3_x64_128	[value, seed]
rapidhash	[value]
rapidhash	[value, seed]
rapidhash_micro	[value]
rapidhash_micro	[value, seed]
rapidhash_nano	[value]
rapidhash_nano	[value, seed]
xxh32	[value]
xxh32	[value, seed]
xxh3_128	[value]
xxh3_128	[value, seed]
xxh3_128_hex	[value]
xxh3_128_hex	[value, seed]
xxh3_64	[value]
xxh3_64	[value, seed]
xxh64	[value]
xxh64	[value, seed]

query II
SELECT DISTINCT function_name, parameters FROM duckdb_functions()
WHERE function_name IN ('wyhash', 'komihash', 'siphash13', 'siphash24', 'crc32c', 'fnv1a_32', 'fnv1a_64', 'farm_fingerprint', 'spark_hash', 'spark_xxhash64', 'kafka_murmur2', 'kafka_partition', 'clickhouse_cityhash64')
ORDER BY ALL;
----
clickhouse_cityhash64	[value]
crc32c	[value]
crc32c	[value, crc]
farm_fingerprint	[value]
fnv1a_32	[value]
fnv1a_64	[value]
kafka_murmur2	[value]
kafka_partition	[key, partitions]
komihash	[value]
komihash	[value, seed]
siphash13	[value]
siphash13	[value, key]
siphash24	[value]
siphash24	[value, key]
spark_hash	[value]
spark_xxhash64	[value]
wyhash	[value]
wyhash	[value, seed]

# The parameters are still positional: calls work as before

query II
SELECT xxh32('hello world'), xxh32('hello world', 42);
----
3468387874	4225033588

query I
SELECT murmurhash3_32('hello world');
----
1586663183
