# CRC-32C as computed by java.util.zip.CRC32C, including the standard check value.
query I
SELECT crc32c('123456789');
----
3808858755

query I
SELECT crc32c('');
----
0

query I
SELECT crc32c('a');
----
3251651376

query I
SELECT crc32c('ab');
----
