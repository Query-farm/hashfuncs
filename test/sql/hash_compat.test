# name: test/sql/hash_compat.test
# description: hashes of previously supported types stay identical, so stored hash keys remain valid
# group: [sql]

# Expected values were generated with the extension before the executor refactor (2026102001). DATE and
# TIME are covered in hash_types.test: that release raised an internal error when hashing them.

require hashfuncs

statement ok
CREATE TABLE compat AS SELECT * FROM (VALUES
  (1, 'hello world', '\xDE\xAD\xBE\xEF'::BLOB, -7::TINYINT, -300::SMALLINT, 42::INTEGER, 42::BIGINT,
   42::HUGEINT, 7::UTINYINT, 300::USMALLINT, 42::UINTEGER, 42::UBIGINT, 42::UHUGEINT, 1.5::FLOAT, 3.25::DOUBLE),
  (2, '', ''::BLOB, 127::TINYINT, 32767::SMALLINT, (-2147483648)::INTEGER, 9223372036854775807::BIGINT,
   (-170141183460469231731687303715884105728)::HUGEINT, 255::UTINYINT, 65535::USMALLINT, 4294967295::UINTEGER,
   18446744073709551615::UBIGINT, 340282366920938463463374607431768211455::UHUGEINT, -2.5::FLOAT, -1e300::DOUBLE),
  (3, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL)
) t(id, c_varchar, c_blob, c_tinyint, c_smallint, c_integer, c_bigint, c_hugeint, c_utinyint, c_usmallint,
    c_uinteger, c_ubigint, c_uhugeint, c_float, c_double);

query II
SELECT xxh32(c_varchar)::VARCHAR, xxh32(c_varchar, 7)::VARCHAR FROM compat ORDER BY id;
----
3468387874	3401553733
46947589	3618484216
NULL	NULL

